@using AntDesign
@using AquaSolution.Shared.ScrapManagement.Scrap
@using AquaSolution.Shared.ScrapManagement.Materials
@using AquaSolution.Shared.UserManagements
@using AquaSolution.Shared.Enum.Scrap

<style>
    .scrap-info-field {
        background: #fbfbfb;
        border-radius: 6px;
        padding: 6px 12px;
        border: 1px solid #e8e8e8;
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 40px;
        box-sizing: border-box;
    }
    .scrap-info-label {
        font-size: 13px;
        color: #595959;
        font-weight: 600;
        white-space: nowrap;
        min-width: 80px;
    }
    .scrap-info-value {
        font-size: 13px;
        font-weight: 500;
        color: #262626;
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .scrap-title-field {
        background: #fafafa;
        border-radius: 6px;
        padding: 10px 14px;
        border: 1px solid #f0f0f0;
    }
    .fix-table-header table thead th {
        position: sticky !important;
        top: 0;
        z-index: 8 !important;
        background-color: #fafafa;
    }
    .fix-table-wrapper {
        max-height: 380px;
        overflow: auto;
        border: 1px solid #f0f0f0;
        border-radius: 6px;
    }
    .readonly-cell { color: #999; font-size: 13px; }
    .step-tag {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px; height: 24px;
        border-radius: 50%;
        color: #fff;
        font-size: 11px; font-weight: 600;
        flex-shrink: 0; margin-top: 2px;
    }
    .step-card {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 6px 10px;
        border: 0.5px solid #e8e8e8;
        border-radius: 6px;
        background: #fafafa;
        min-width: 150px;
        max-width: 220px;
        flex: 1;
    }
    .step-card-info { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
    .step-card-step { font-size: 12px; font-weight: 600; color: #1677ff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .step-card-name { font-size: 12px; color: #222; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .step-card-sub { font-size: 11px; color: #666; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .step-card-comment { font-size: 11px; color: #d48806; font-style: italic; margin-top: 2px; }
    .step-separator { color: #d9d9d9; font-size: 16px; flex-shrink: 0; }
    .steps-row {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-wrap: nowrap;
        overflow-x: auto;
        padding: 4px 0;
        margin-bottom: 4px;
    }
    .confirm-section {
        background: #f6ffed;
        border: 1px solid #b7eb8f;
        border-radius: 8px;
        padding: 12px 16px;
    }
</style>

@{
    // Kiểm tra step của CurrenUser có đang InterView không
    // => chỉ khi đó mới cho phép bấm Approve / Reject
    var _myStep = HandleScrap?.Approvals?
        .FirstOrDefault(a => a.DecisionMaker == CurrenUser!.Id);
    var _canAct = _myStep?.Status == StatusScrap.InterView;

    var _isCreatorStepInterView = Mode == ScrapModalMode.Detail 
        && _myStep?.Step == 1 
        && _myStep?.Status == StatusScrap.InterView;
    var _isEditable = Mode == ScrapModalMode.Create || _isCreatorStepInterView;

    // Kiểm tra quyền nhận hàng
    var _rcvStep = HandleScrap?.Approvals?.FirstOrDefault(a => a.Title == "Người nhận hàng");
    var _canConfirm = (Mode == ScrapModalMode.Confirm) && (_rcvStep == null || _rcvStep.Status == StatusScrap.InterView);
    var _isConfirmed = HandleScrap?.Status == StatusScrap.Done || (_rcvStep != null && _rcvStep.Status == StatusScrap.Approved);

    RenderFragment footer =
        @<div style="display:flex; gap:8px; justify-content:flex-end">
            <Button OnClick="Close">Đóng</Button>
            @if (Mode == ScrapModalMode.Create)
            {
                <Button Type="ButtonType.Primary" Loading="@_submitting" OnClick="SubmitAsync">Tạo phiếu</Button>
            }
            @if (_isCreatorStepInterView)
            {
                <Button Type="ButtonType.Primary" Loading="@_submitting" OnClick="ResubmitAsync">Cập nhật & Nộp lại</Button>
            }
            @if (Mode == ScrapModalMode.Approval && _canAct)
            {
                <Button Danger Loading="@_submitting" OnClick="RejectAction">Reject</Button>
                <Button Type="ButtonType.Primary"
                        Style="background:#52c41a; border-color:#52c41a;"
                        Loading="@_submitting"
                        OnClick="ApproveAction">Approve</Button>
            }
            @if (Mode == ScrapModalMode.Confirm && _canConfirm)
            {
                <Button Type="ButtonType.Primary" Loading="@_submitting" OnClick="ConfirmAction">Xác nhận nhận hàng</Button>
            }
        </div>;
}

<Modal @bind-Visible="IsModalVisible"
       Title="@ModalTitle"
       Style="z-index:9999; width:96vw; max-width:98vw; margin-top:-95px"
       Footer="@footer"
       Draggable="true"
       OnCancel="Close">

    @if (_loading)
    {
        <div style="text-align:center; padding:40px"><Spin /></div>
    }
    else if (HandleScrap == null || CurrenUser == null)
    {
        <div style="text-align:center; padding:40px"><Spin /></div>
    }
    else
    {
        <div style="display:flex; flex-direction:column; gap:10px;">

            @* Step Process - Luôn hiển thị khi Tạo phiếu, Xem chi tiết, Duyệt và Xác nhận *@
            @{
                var displayApprovals = Mode == ScrapModalMode.Create 
                    ? _previewApprovals 
                    : HandleScrap?.Approvals;
            }
            @if (displayApprovals != null && displayApprovals.Any())
            {
                <div>
                    <div style="font-size:11px; font-weight:600; text-transform:uppercase; color:#999; margin-bottom:6px; letter-spacing:.06em; display:flex; align-items:center; gap:6px;">
                        <Icon Type="apartment" /> Luồng duyệt @(Mode == ScrapModalMode.Create ? "(Dự kiến)" : "")
                    </div>
                    <div class="steps-row">
                        @foreach (var step in displayApprovals.OrderBy(x => x.Step))
                        {
                            var stepInfo = GetStepStatusDisplay(step, Mode);
                            @if (step.Step > 1)
                            {
                                <span class="step-separator">→</span>
                            }
                            <div class="step-card" style="border:@stepInfo.CardBorder; background:@stepInfo.CardBg;">
                                <div class="step-tag" style="background:@stepInfo.Color;">@step.Step</div>
                                <div class="step-card-info">
                                    <div class="step-card-step">@step.Title</div>
                                    <div class="step-card-name">
                                        @(step.ActionByName ?? step.DecisionMakerName ?? "—")
                                    </div>
                                    <div class="step-card-sub">
                                        @(step.ActionByWorkDayId ?? step.DecisionMakerWorkDayId ?? "")
                                    </div>
                                    <div class="step-card-sub">
                                        @(step.ActionByEmail ?? step.DecisionMakerEmail ?? "")
                                    </div>
                                    <Tag Color="@stepInfo.Color" Style="font-size:10px; margin-top:4px; text-align:center; font-weight:600; width:100%; border-radius:3px;">
                                        @stepInfo.StatusText
                                    </Tag>
                                    @if (step.ActionDate.HasValue)
                                    {
                                        <div class="step-card-sub">@step.ActionDate.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                    }
                                    @if (!string.IsNullOrEmpty(step.Comment))
                                    {
                                        <div class="step-card-comment">💬 @step.Comment</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Form Information: Unified 3-Column Grid *@
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">

                @* Row 1: Tiêu đề trước (span 2), Người tạo sau (span 1) *@
                <div class="scrap-info-field" style="grid-column: span 2;">
                    <span class="scrap-info-label">Tiêu đề:</span>
                    <span class="scrap-info-value" style="font-size: 14px; font-weight: 600; color: #1677ff;">
                        @HandleScrap?.Title
                    </span>
                </div>
                <div class="scrap-info-field">
                    <span class="scrap-info-label">Người tạo:</span>
                    <span class="scrap-info-value">
                        @if (Mode == ScrapModalMode.Create)
                        {
                            @($"{CurrenUser?.WorkDayId} — {CurrenUser?.FullName}")
                        }
                        else
                        {
                            @HandleScrap?.CreatedByName
                        }
                    </span>
                </div>

                @* Row 2: Thông tin Factory, Department, Section (mỗi mục 1 cột) *@
                <div class="scrap-info-field">
                    <span class="scrap-info-label">Factory:</span>
                    <span class="scrap-info-value">
                        @(Mode == ScrapModalMode.Create ? CurrenUser?.FactoryName : HandleScrap?.FactoryName)
                    </span>
                </div>
                <div class="scrap-info-field">
                    <span class="scrap-info-label">Department:</span>
                    <span class="scrap-info-value">
                        @(Mode == ScrapModalMode.Create ? CurrenUser?.DepartmentName : HandleScrap?.DepartmentName)
                    </span>
                </div>
                <div class="scrap-info-field">
                    <span class="scrap-info-label">Section:</span>
                    <div style="flex: 1;">
                        @if (_isEditable)
                        {
                            if (CurrenUser?.Sections != null && CurrenUser.Sections.Any())
                            {
                                <Select TItem="AquaSolution.Shared.Administration.Sections.SectionDto" TItemValue="Guid?"
                                        DataSource="@CurrenUser.Sections"
                                        @bind-Value="@HandleScrap!.SectionId"
                                        OnSelectedItemChanged="OnSectionChanged"
                                        ItemValue="c => c.Id"
                                        ItemLabel="c => c.Name"
                                        Style="width: 100%;">
                                </Select>
                            }
                            else
                            {
                                <span style="color:red">(No Section)</span>
                            }
                        }
                        else
                        {
                            <span class="scrap-info-value">@HandleScrap?.SectionName</span>
                        }
                    </div>
                </div>

                @* Row 3: Ngày tạo, Trạng thái, Trách nhiệm (mỗi mục 1 cột) *@
                <div class="scrap-info-field">
                    <span class="scrap-info-label">Ngày tạo:</span>
                    <span class="scrap-info-value">
                        @(Mode == ScrapModalMode.Create ? DateTime.Now.ToString("dd/MM/yyyy HH:mm") : HandleScrap?.CreatedDate.ToString("dd/MM/yyyy HH:mm"))
                    </span>
                </div>
                <div class="scrap-info-field">
                    <span class="scrap-info-label">Trạng thái:</span>
                    @{
                        var (sColor, sText) = HandleScrap!.Status switch
                        {
                            StatusScrap.WaitingForApproval     => ("#1677ff", "Waiting for Approval"),
                            StatusScrap.WaitingForConfirmation => ("#fa8c16", "Waiting for Confirmation"),
                            StatusScrap.Approved               => ("#52c41a", "Approved"),
                            StatusScrap.Rejected               => ("#ff4d4f", "Rejected"),
                            StatusScrap.InterView              => ("#1677ff", "Waiting for Approval"),
                            StatusScrap.Done                   => ("#722ed1", "Done"),
                            _                                  => ("#faad14", "Pending")
                        };
                    }
                    <div style="flex: 1;">
                        <Tag Color="@sColor" Style="margin: 0; font-weight: 500;">@sText</Tag>
                    </div>
                </div>
                <div class="scrap-info-field">
                    <span class="scrap-info-label">Trách nhiệm:</span>
                    <div style="display:flex; gap:6px; align-items:center; flex:1; width:100%;">
                        @if (_isEditable)
                        {
                            <Select TItem="string" TItemValue="string"
                                    Value="@SelectedResponsibilityOption"
                                    ValueChanged="@((string val) => OnResponsibilityChanged(val))"
                                    Placeholder="Vui lòng chọn"
                                    Style="flex: 1; min-width: 120px;">
                                <SelectOptions>
                                    <SelectOption Value="@("Lỗi nhà cung cấp")" Label="Lỗi nhà cung cấp" />
                                    <SelectOption Value="@("Thay đổi kỹ thuật")" Label="Thay đổi kỹ thuật" />
                                    <SelectOption Value="@("Lỗi sản xuất")" Label="Lỗi sản xuất" />
                                    <SelectOption Value="@("Thiếu hụt")" Label="Thiếu hụt" />
                                    <SelectOption Value="@("Khác")" Label="Khác" />
                                </SelectOptions>
                            </Select>
                            @if (SelectedResponsibilityOption == "Khác")
                            {
                                <AntDesign.Input @bind-Value="CustomResponsibility"
                                                 Placeholder="Nhập khác..."
                                                 Style="flex: 1; min-width: 90px;" />
                            }
                        }
                        else
                        {
                            <span class="scrap-info-value">@(HandleScrap?.Responsibility ?? "—")</span>
                        }
                    </div>
                </div>

                @* Row 4: Mô tả đứng 1 mình (span 3) *@
                <div style="grid-column: span 3;">
                    <div class="scrap-info-label" style="margin-bottom: 4px;">Mô tả:</div>
                    <TextArea @bind-Value="HandleScrap!.Description"
                              Rows="2"
                              Disabled="@(!_isEditable)"
                              Placeholder="Nhập mô tả chi tiết nếu có..." />
                </div>
            </div>

            <Divider Style="margin:6px 0" />

            @* Detail table *@
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                <span style="font-size:11px; font-weight:600; text-transform:uppercase; color:#999; letter-spacing:.06em;">
                    Chi tiết vật tư
                    @if (HandleScrap?.TotalAmount > 0)
                    {
                        <span style="color:#1677ff; margin-left:8px;">
                            Tổng: @HandleScrap.TotalAmount?.ToString("N2") kg
                        </span>
                    }
                </span>
                @if (_isEditable)
                {
                    <Button Size="ButtonSize.Small" OnClick="AddRow">
                        <Icon Type="plus" Theme="IconThemeType.Outline" /> Thêm dòng
                    </Button>
                }
            </div>

            <div class="fix-table-wrapper">
                <Table DataSource="@_details"
                       TItem="HistoryDetailScrapDto"
                       HidePagination="true"
                       Class="fix-table-header"
                       Size="TableSize.Small">
                    <ColumnDefinitions Context="context">

                        <Column TData="string" Title="#" Width="36px">
                            @(_details.IndexOf(context) + 1)
                        </Column>

                        <Column TData="Guid" Title="Mã VT" Width="200px">
                            <Select TItem="MaterialDto"
                                    TItemValue="Guid"
                                    DataSource="@_materials"
                                    Value="context.MaterialId"
                                    EnableSearch
                                    ValueChanged="(val) => OnMaterialIdChanged(context, val)"
                                    ValueName="@nameof(MaterialDto.Id)"
                                    LabelName="@nameof(MaterialDto.Code)"
                                    Placeholder="-- Chọn --"
                                    Style="width:100%"
                                    Disabled="@(!_isEditable)"
                                    AllowClear>
                                <ItemTemplate Context="mat">
                                    <div style="line-height:1.3">
                                        <div style="font-weight:500;">@mat.Code</div>
                                        <div style="font-size:11px; color:#999;">@mat.Name</div>
                                    </div>
                                </ItemTemplate>
                            </Select>
                        </Column>

                        <Column TData="string" Title="Tên VT" Width="160px">
                            <span class="readonly-cell">@(context.Name ?? "—")</span>
                        </Column>

                        @* Các cột khi nhận hàng được đưa lên ngay sau Mã VT và Tên VT *@
                        @if (Mode == ScrapModalMode.Confirm || _isConfirmed)
                        {
                            <Column TData="ConfirmUnitType" Title="Phương thức nhận" Width="100px">
                                @if (!_canConfirm)
                                {
                                    <span class="readonly-cell">@(context.ConfirmUnitType == ConfirmUnitType.Weight ? "KG" : "PCS")</span>
                                }
                                else
                                {
                                    <Select TItem="ConfirmUnitType"
                                            TItemValue="ConfirmUnitType"
                                            Value="context.ConfirmUnitType"
                                            ValueChanged="@((ConfirmUnitType val) => { context.ConfirmUnitType = val; StateHasChanged(); })"
                                            Style="width:100%">
                                        <SelectOptions>
                                            <SelectOption Value="@ConfirmUnitType.Weight" Label="KG" />
                                            <SelectOption Value="@ConfirmUnitType.Unit" Label="PCS" />
                                        </SelectOptions>
                                    </Select>
                                }
                            </Column>

                            <Column TData="decimal?" Title="Thực nhận" Width="90px">
                                @if (!_canConfirm)
                                {
                                    <span class="readonly-cell">@(context.ConfirmAmount?.ToString() ?? "—")</span>
                                }
                                else
                                {
                                    <AntDesign.InputNumber TValue="decimal?"
                                                           Value="context.ConfirmAmount"
                                                           ValueChanged="@((decimal? val) => { context.ConfirmAmount = val; })"
                                                           Min="0"
                                                           Style="width:100%" />
                                }
                            </Column>

                            <Column TData="string" Title="Loại" Width="130px">
                                @if (!_canConfirm)
                                {
                                    <span class="readonly-cell">@(context.WasteType ?? "—")</span>
                                }
                                else
                                {
                                    <Select TItem="string"
                                            TItemValue="string"
                                            DataSource="@_wasteCategories"
                                            Value="@context.WasteType"
                                            ValueChanged="@((string val) => OnWasteTypeChanged(context, val))"
                                            Placeholder="-- Chọn --"
                                            Style="width:100%"
                                            AllowClear>
                                    </Select>
                                }
                            </Column>

                            <Column TData="string" Title="Mã phế liệu / Chất thải" Width="240px">
                                @if (!_canConfirm)
                                {
                                    <span class="readonly-cell">@(!string.IsNullOrEmpty(context.WasteCode) ? $"{context.WasteCode} - {context.WasteName}" : "—")</span>
                                }
                                else
                                {
                                    <Select TItem="WasteItemDto"
                                            TItemValue="string"
                                            DataSource="@_wasteItems.Where(x => string.Equals(x.Category, context.WasteType, StringComparison.OrdinalIgnoreCase)).ToList()"
                                            Value="@context.WasteCode"
                                            ValueChanged="@((string code) => OnWasteCodeChanged(context, code))"
                                            ValueName="@nameof(WasteItemDto.Code)"
                                            LabelName="@nameof(WasteItemDto.DisplayText)"
                                            Placeholder="@(string.IsNullOrEmpty(context.WasteType) ? "-- Chọn loại --" : "-- Chọn mã --")"
                                            Disabled="@string.IsNullOrEmpty(context.WasteType)"
                                            EnableSearch
                                            Style="width:100%"
                                            AllowClear>
                                        <ItemTemplate Context="waste">
                                            <div style="line-height:1.3">
                                                <span style="font-weight:600; color:#1890ff;">@waste.Code</span>
                                                <span style="color:#333; margin-left:6px;">@waste.Name</span>
                                            </div>
                                        </ItemTemplate>
                                    </Select>
                                }
                            </Column>

                            <Column TData="string" Title="Ghi chú" Width="120px">
                                @if (!_canConfirm)
                                {
                                    <span class="readonly-cell">@(context.ConfirmNote ?? "—")</span>
                                }
                                else
                                {
                                    <AntDesign.Input Value="context.ConfirmNote"
                                                     ValueChanged="@((string val) => context.ConfirmNote = val)"
                                                     Placeholder="Ghi chú..." />
                                }
                            </Column>
                        }

                        <Column TData="string" Title="ĐVT" Width="55px">
                            <span class="readonly-cell">@(context.Unit ?? "—")</span>
                        </Column>
                        <Column TData="decimal" Title="Số lượng" Width="80px">
                            <AntDesign.InputNumber TValue="decimal"
                                                   Value="context.Quantity"
                                                   ValueChanged="(val) => context.Quantity = val"
                                                   Min="0"
                                                   Disabled="@(!_isEditable)"
                                                   Style="width:100%" />
                        </Column>
                        <Column TData="decimal" Title="Trọng lượng (kg)" Width="85px">
                            <span class="readonly-cell">@context.Weight</span>
                        </Column>
                        <Column TData="decimal" Title="Tổng TL (kg)" Width="85px">
                            <span class="readonly-cell">@((context.Quantity * context.Weight).ToString("N2"))</span>
                        </Column>
                        <Column TData="string" Title="Vị trí" Width="100px">
                            @if (_isEditable)
                            {
                                <AntDesign.Input @bind-Value="context.WarehouseLocation"
                                                 Placeholder="Vị trí..." />
                            }
                            else
                            {
                                <span class="readonly-cell">@(context.WarehouseLocation ?? "—")</span>
                            }
                        </Column>
                        <Column TData="string" Title="Lý do" Width="120px">
                            <AntDesign.Input @bind-Value="context.Reson"
                                             Disabled="@(!_isEditable)"
                                             Placeholder="Lý do..." />
                        </Column>
                        <Column TData="string" Title="BOM Head" Width="100px">
                            <span class="readonly-cell">@(context.BOMHead ?? "—")</span>
                        </Column>
                        <Column TData="string" Title="Loại VT" Width="65px">
                            <span class="readonly-cell">@(context.TYPE ?? "—")</span>
                        </Column>
                        <Column TData="string" Title="Nhà máy" Width="60px">
                            <span class="readonly-cell">@context.Plant</span>
                        </Column>
                        <Column TData="string" Title="Hình ảnh" Width="85px">
                            @if (!string.IsNullOrEmpty(context.ImageUrl))
                            {
                                <div style="display:flex; align-items:center; gap:6px;">
                                    <img src="@context.ImageUrl"
                                         @onclick="() => PreviewImage(context.ImageUrl)"
                                         style="width:32px; height:32px; object-fit:cover; border-radius:4px; border:1px solid #d9d9d9; cursor:pointer;"
                                         title="Bấm để xem ảnh phóng to" />
                                    @if (_isEditable)
                                    {
                                        <Button Type="ButtonType.Text" Danger Icon="delete" Size="ButtonSize.Small"
                                                OnClick="() => context.ImageUrl = null" />
                                    }
                                </div>
                            }
                            else if (_isEditable)
                            {
                                <label class="ant-btn ant-btn-sm"
                                       style="display:inline-flex; align-items:center; gap:4px; cursor:pointer; margin-bottom:0; color:#1890ff; border-color:#91d5ff;">
                                    <Icon Type="upload" /> Tải lên
                                    <Microsoft.AspNetCore.Components.Forms.InputFile OnChange="@(e => HandleImageUpload(context, e))"
                                                                                    accept="image/*"
                                                                                    style="display:none;" />
                                </label>
                            }
                            else
                            {
                                <span class="readonly-cell">—</span>
                            }
                        </Column>

                        @if (_isEditable)
                        {
                            <Column TData="string" Title="" Width="36px">
                                <Button Size="ButtonSize.Small" Danger Shape="ButtonShape.Circle"
                                        Icon="delete" OnClick="() => RemoveRow(context)" />
                            </Column>
                        }

                    </ColumnDefinitions>
                </Table>
            </div>

        </div>
    }
</Modal>

@* Reject comment modal *@
@{
    RenderFragment rejectFooter =
        @<div style="display:flex; gap:8px; justify-content:flex-end">
            <Button OnClick="CloseRejectModal">Hủy</Button>
            <Button Danger Loading="@_submitting" OnClick="ConfirmRejectAction">Xác nhận từ chối</Button>
        </div>;
}

<Modal Title="Lý do từ chối"
       Visible="IsRejectModalVisible"
       OnCancel="CloseRejectModal"
       Footer="@rejectFooter"
       Width="520">
    <p style="font-size:13px; color:#555; margin-bottom:8px;">
        Phiếu: <strong>@HandleScrap?.Title</strong>
    </p>
    <textarea class="ant-input"
              rows="4"
              placeholder="Nhập lý do từ chối..."
              @bind="RejectComment"
              style="width:100%; resize:vertical; padding:8px; border-radius:4px; font-size:13px;">
    </textarea>
</Modal>

@* Preview image modal *@
<Modal Title="Xem hình ảnh đính kèm"
       Visible="@(!string.IsNullOrEmpty(_previewImageUrl))"
       OnCancel="() => _previewImageUrl = null"
       Footer="null"
       Width="750">
    <div style="text-align:center; padding:10px;">
        @if (!string.IsNullOrEmpty(_previewImageUrl))
        {
            <img src="@_previewImageUrl" style="max-width:100%; max-height:75vh; object-fit:contain; border-radius:6px; box-shadow:0 2px 8px rgba(0,0,0,0.15);" />
        }
    </div>
</Modal>
