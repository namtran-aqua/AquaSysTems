@using System.ComponentModel.DataAnnotations
@using AntDesign 

@inject IMessageService Message
@using AquaSolution.Shared.AuthModels
@using AquaSolution.Shared.PasswordHelpers
@inject NavigationManager Nav
@{
    RenderFragment footer = @<Template>

        <Button OnClick="@SaveAsync" @key="@( "submit" )"
                Type="ButtonType.Primary">
            Save
        </Button>

        <Button Style="color:#808080" OnClick="@HandleCancel" @key="@("back")">Close</Button>

    </Template>;
}
<Modal @bind-Visible="_visible" Title="Change Password" Width="650" Footer="@footer">
    <Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-bottom: 16px;">
        <MessageTemplate>
            <strong>Yêu cầu bảo mật mật khẩu:</strong>
            <ul style="margin-bottom: 0; padding-left: 20px; font-size: 13px;">
                <li>Độ dài tối thiểu 10 ký tự.</li>
                <li>Chứa ít nhất 3 trong 4 nhóm: chữ hoa (A-Z), chữ thường (a-z), chữ số (0-9) và ký tự đặc biệt (!@@#$%^&*...).</li>
                <li>Không chứa ký tự liên tiếp (123, abc, qwe...), ký tự lặp lại (aaa, 111...) hoặc thông tin cá nhân.</li>
            </ul>
        </MessageTemplate>
    </Alert>

    <EditForm Model="_model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <Form @ref="@formRef" TModel="ChangePassRequest" Model="_model" Layout="FormLayout.Horizontal"
              LabelColSpan="6" WrapperColSpan="18">
            <ChildContent Context="formCtx">
                <FormItem Required="true" Label="Old Password">
                    <InputPassword @bind-Value="_model.OldPassword" />
                </FormItem>

                <FormItem Required="true" Label="New Password">
                    <InputPassword @bind-Value="_model.NewPassword" />
                </FormItem>

                <FormItem Required="true" Label="Confirm Password">
                    <InputPassword @bind-Value="_model.ConfirmPassword" />
                </FormItem>
            </ChildContent>
        </Form>

    </EditForm>
</Modal>
