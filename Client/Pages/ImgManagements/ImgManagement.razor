@page "/img-management"
@using AquaSolution.Client.Common
@using AquaSolution.Client.Modals.Administration.Users
@using AntDesign
@inject IJSRuntime JSRuntime
@inject ModalService modal
@inject NavigationManager Navigation
@inject IMessageService Message
@using AquaSolution.Shared.HRMS
@using AquaSolution.Shared.Imgs
@using AquaSolution.Shared.KPI.IndexWeight
@using AquaSolution.Shared.UserManagements
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionService permissionService
<PageTitle>Users</PageTitle>
<div class="mb-3">
    <style>
            .custom-button-type {
                height: 30px;
                font-size: 12px;
            }

            .fix-table-header table {
                border-collapse: collapse;
            }

                .fix-table-header table thead th {
                    position: sticky !important;
                    z-index: 8 !important;
                    top: 0;
                    background-color: #fff;
                }

            .ant-table-content {
                min-height: 65vh !important;
            }

            .ant-table-pagination {
                position: fixed;
                bottom: 0;
                width: 100%;
                z-index: 999;
                background: white;
                padding: 8px;
                text-align: center;
                box-shadow: 0 -1px 4px rgba(0, 0, 0, 0.1);
                background: transparent !important;
            }



            .custom-label {
                background-color: #007bff;
                color: white;
                padding: 8px 15px;
                border-radius: 5px;
                cursor: pointer;
                display: inline-block;
            }

                .custom-label:hover {
                    background-color: #0056b3;
                }
    </style>
    <div style="display: flex;  align-items: center; margin-bottom: 10px;">
    </div>
</div>
<script>
    window.downloadFile = async (url, fileName) => {
        const res = await fetch(url);
        const blob = await res.blob();
        const link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = fileName;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };
</script>
<div style="width:100%;overflow-x:scroll ;max-height:70vh; ">

    
    @if (Loading)
    {
        <div class="loading-overlay">
            <Spin Tip="Đang tải dữ liệu..." Size="SpinSize.Large" />
        </div>
    }
    else
    {
        <Collapse Accordion="true">
     
            @foreach (var group in images)
            {
                <Panel Header="@($"{group.FolderName} ({group.GoogleDriveImageDtos.Count})")">
                    @if (CurrenUser.Roles.Any(x => x.Name == "Admin"))
                    {
                        <Button OnClick="@(async () => await DeleteAllImg(group.FolderName))">
                            <Icon Type="delete" /> Delete All
                        </Button>
                    }
                    <Button OnClick="@(async () => await DownloadSelectedImg(group.FolderName))" Style="margin-left: 8px;">
                        <Icon Type="download" /> Download Selected
                    </Button>
                    @if (!SelectedMap.ContainsKey(group.FolderName))
                    {
                        SelectedMap[group.FolderName] = new List<GoogleDriveImageDto>();
                    }

                    <Table TItem="GoogleDriveImageDto"
                           DataSource="group.GoogleDriveImageDtos"
                           Size="TableSize.Small"
                           Bordered
                           RowKey="x => x.FileId"
                           OnSelectAll="(b) => OnSelectAll(b, group.FolderName)"
                           @bind-SelectedRows="SelectedMap[group.FolderName]"
                           HidePagination
                           Loading="@Loading"
                           Class="customTable fix-table-header">
                       
                        <ColumnDefinitions Context="row">
                            <Selection></Selection>
                            <!-- Action -->
                            <Column Align="ColumnAlign.Center" TData="GoogleDriveImageDto" Width="50px" Title="Action">
                                @if (CurrenUser.Roles.Any(x => x.Name == "Admin"))
                                {
                                    <Template Style="gap:5px">
                                        <ActionColumn>
                                            <Button Type="ButtonType.Text" OnClick="@(async () => await Delete(row))" Style="text-align: left;">
                                                <Icon Type="delete" /> Delete
                                            </Button>
                                        </ActionColumn>
                                    </Template>
                                }
                                <Template Style="gap:5px">
                                    <ActionColumn>
                                        <a href="/api/Img/thumbnail/@row.FileId" target="_blank" style="width:500px;height:500px;">
                                            👁View
                                        </a>
                                    </ActionColumn>
              
                                </Template>
                               
                            </Column>
                            <!-- Ảnh -->
                            <Column Align="ColumnAlign.Center" TData="GoogleDriveImageDto" Width="170px" Title="Image">
                                <Template>
                                    <img src="@(string.IsNullOrEmpty(row.ThumbnailLink) ? $"/api/Img/thumbnail/{row.FileId}" : row.ThumbnailLink)"
                                         style="width:100px;height:100px;object-fit:cover;border-radius:4px;"
                                         loading="lazy" />
                                </Template>
                            </Column>


                            <PropertyColumn Align="ColumnAlign.Center" Width="200px"
                                            Title="File Name"
                                            Property="c => c.FileName" />

                            <!-- File Size -->
                            <Column Align="ColumnAlign.Center" TData="GoogleDriveImageDto" Width="100px" Title="Size">
                                <Template>
                                    @(row.FileSize.HasValue ? $"{Math.Round((double)row.FileSize.Value / 1024, 2)} KB" : "")
                                </Template>
                            </Column>

                            <!-- Upload Date -->
                            <Column Align="ColumnAlign.Center" Sortable TData="GoogleDriveImageDto" Width="160px" Title="Uploaded At">
                                <Template>
                                    @(row.CreatedTime?.ToString("dd/MM/yyyy HH:mm") ?? "")
                                </Template>
                            </Column>

                        </ColumnDefinitions>
                    </Table>
                </Panel>
            }
        </Collapse>
    }

    
</div>
