@page "/section-management"
@using AquaSolution.Client.Modals.Administration.Sections
@using AntDesign
@inject ModalService Modal
@inject IMessageService Message
@using AquaSolution.Shared.Administration.Sections
<PageTitle>Section Management</PageTitle>
<div class="mb-3">
    <style>
        .custom-button-type {
            height: 30px;
            font-size: 12px;
        }

        .fix-table-header table {
            border-collapse: collapse;
        }

            .fix-table-header table thead th {
                position: sticky !important;
                z-index: 8 !important;
                top: 0;
                background-color: #fff;
            }

        

        

    </style>
    <button @onclick="CreatedSection" class="btn btn-primary custom-button-type">
        <Icon Type="plus" />Created
    </button>
</div>
<div style="width:99%;overflow-x:scroll ;max-height: 70vh; ">
    <Table TItem="SectionDto"
           Size="TableSize.Small"
           Class="customTable fix-table-header"
           DataSource="_listSection">
        <ColumnDefinitions Context="row">
            <PropertyColumn Title="Code" Property="c => c.Code"></PropertyColumn>
            <PropertyColumn Title="Name" Property="c => c.Name"></PropertyColumn>
            <PropertyColumn Title="Department" Property="c => c.DepartmentName"></PropertyColumn>
            <PropertyColumn Width="250px" Title="Description" Property="c => c.Description"></PropertyColumn>
            <PropertyColumn Title="CreatedDate" Property="c => c.CreatedDate"></PropertyColumn>
            <Column Fixed="ColumnFixPlacement.Right" TData="SectionDto" Width="50px"  Context="row">
                <Template>
                    <Popover Title="Actions" Trigger="new Trigger[] { Trigger.Click }" Placement="Placement.Bottom">
                        <ChildContent>
                            <Button Icon="menu" />
                        </ChildContent>
                        <ContentTemplate>
                            <div style="display: flex; flex-direction: column; gap: 4px; padding: 8px;">
                                <Button Type="ButtonType.Text" OnClick="@(async () => await EditSection(row))" Style="text-align: left;">
                                    <Icon Type="plus" /> Edit
                                </Button>
                                <Button Type="ButtonType.Text" OnClick="@(async () => await DeleteAsync(row))" Style="text-align: left;">
                                    <Icon Type="delete" /> Delete
                                </Button>
                            </div>
                        </ContentTemplate>
                    </Popover>
                </Template>
            </Column>
        </ColumnDefinitions>
    </Table>
</div>
<SectionModal OnSave="LoadDataAsync" @ref="@_sectionModal"></SectionModal>
