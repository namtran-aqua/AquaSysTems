@page "/feedback-management"
@page "/itsm/feedback-management"

@using AntDesign
@using AquaSolution.Shared.Enum
@using AquaSolution.Shared.Feedbacks
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IMessageService Message
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Quản Lý Ý Kiến & Đóng Góp - Admin</PageTitle>

<div class="feedback-admin-container">
    <!-- APPS SCRIPT STYLE HEADER BANNER -->
    <div class="appscript-header-banner">
        <div class="banner-left">
            <h1 class="banner-title">AQUA – KÊNH THEO DÕI & QUẢN LÝ PHẢN ÁNH</h1>
            <p class="banner-subtitle">Bảng tiếp nhận thông tin gian lận & vi phạm liêm chính</p>
            @if (lastSyncTime.HasValue)
            {
                <div class="banner-sync-info">
                    <Icon Type="clock-circle" />
                    <span>Lần đồng bộ gần nhất: <strong>@lastSyncTime.Value.ToString("dd/MM/yyyy HH:mm:ss")</strong></span>
                    @if (!string.IsNullOrEmpty(lastSyncMessage))
                    {
                        <span class="sync-desc ms-1">(@lastSyncMessage)</span>
                    }
                </div>
            }
        </div>
        <div class="banner-right">
            <button class="btn-appscript-refresh" @onclick="SyncFromGoogleSheet" disabled="@isSyncing" title="Đồng bộ dữ liệu mới nhất từ Google Sheet">
                <Icon Type="sync" Spin="@isSyncing" Class="refresh-icon" />
                <span>@(isSyncing ? "Đang đồng bộ..." : "Đồng bộ")</span>
            </button>
        </div>
    </div>

    <!-- 4 STAT CARDS (THEO GIAO DIỆN APPS SCRIPT) -->
    <div class="stats-grid-row">
        <div class="stat-clean-card">
            <div class="stat-clean-title">Tổng phản ánh</div>
            <div class="stat-clean-number text-stat-blue">@dashboardStats.TotalCount</div>
        </div>
        <div class="stat-clean-card">
            <div class="stat-clean-title">Ẩn danh</div>
            <div class="stat-clean-number text-stat-slate">@dashboardStats.AnonymousCount</div>
        </div>
        <div class="stat-clean-card">
            <div class="stat-clean-title">Bảo mật danh tính</div>
            <div class="stat-clean-number text-stat-green">@dashboardStats.ConfidentialCount</div>
        </div>
        <div class="stat-clean-card">
            <div class="stat-clean-title">Có bằng chứng / File</div>
            <div class="stat-clean-number text-stat-amber">@dashboardStats.EvidenceCount</div>
        </div>
    </div>

    <!-- FILTER CARD -->
    <div class="filter-card">
        <div class="row g-3 align-items-end">
            <!-- Search Text -->
            <div class="col-md-3">
                <label class="filter-label">Tìm kiếm từ khóa</label>
                <Input Placeholder="Họ tên, SĐT, nội dung..." 
                       @bind-Value="filter.SearchTerm" 
                       Prefix="@SearchIcon" 
                       AllowClear="true" 
                       OnPressEnter="() => LoadData(1)" />
            </div>

            <!-- Factory Filter -->
            <div class="col-md-2">
                <label class="filter-label">Nhà máy</label>
                <Select TItemValue="string" 
                        TItem="string" 
                        @bind-Value="filter.Factory" 
                        Placeholder="Tất cả nhà máy" 
                        AllowClear="true" 
                        Style="width:100%;">
                    <SelectOptions>
                        <SelectOption Value="@("")" Label="Tất cả nhà máy" />
                        @foreach (var f in factories)
                        {
                            <SelectOption Value="@f" Label="@f" />
                        }
                    </SelectOptions>
                </Select>
            </div>

            <!-- Department Filter -->
            <div class="col-md-2">
                <label class="filter-label">Phòng ban</label>
                <Select TItemValue="string" 
                        TItem="string" 
                        @bind-Value="filter.Department" 
                        Placeholder="Tất cả phòng ban" 
                        AllowClear="true" 
                        Style="width:100%;">
                    <SelectOptions>
                        <SelectOption Value="@("")" Label="Tất cả phòng ban" />
                        @foreach (var d in departments)
                        {
                            <SelectOption Value="@d" Label="@d" />
                        }
                    </SelectOptions>
                </Select>
            </div>

            <!-- Date Range Filter -->
            <div class="col-md-2">
                <label class="filter-label">Từ ngày</label>
                <DatePicker TValue="DateTime?" @bind-Value="filter.FromDate" Style="width:100%;" Format="dd/MM/yyyy" Placeholder="@("Từ ngày")" />
            </div>

            <div class="col-md-2">
                <label class="filter-label">Đến ngày</label>
                <DatePicker TValue="DateTime?" @bind-Value="filter.ToDate" Style="width:100%;" Format="dd/MM/yyyy" Placeholder="@("Đến ngày")" />
            </div>

            <!-- Filter Buttons -->
            <div class="col-md-1 d-flex gap-2">
                <Button Type="@ButtonType.Primary" Icon="search" OnClick="() => LoadData(1)" Loading="@isLoading">
                    Lọc
                </Button>
                <Button Icon="reload" OnClick="ResetFilter">
                </Button>
            </div>
        </div>
    </div>

    <!-- DATA TABLE CARD -->
    <div class="table-card">
        <Table TItem="UserFeedbackDto" 
               DataSource="@feedbacks" 
               Loading="@isLoading" 
               RowKey="x => x.Id.ToString()"
               Total="@totalCount"
               PageIndex="@filter.PageIndex"
               PageSize="@filter.PageSize"
               OnPageIndexChange="OnPageChange"
               Bordered="true"
               ScrollX="1200"
               Size="TableSize.Middle">
            <ColumnDefinitions Context="row">
                <PropertyColumn Title="STT" Width="60" Property="c => c.Id">
                    <span>@((filter.PageIndex - 1) * filter.PageSize + feedbacks.IndexOf(row) + 1)</span>
                </PropertyColumn>

                <PropertyColumn Title="Người gửi" Width="150" Property="c => c.FullName">
                    <div class="user-cell">
                        <span class="user-name">@row.FullName</span>
                        @if (!string.IsNullOrWhiteSpace(row.PhoneNumber))
                        {
                            <span class="user-phone"><Icon Type="phone" /> @row.PhoneNumber</span>
                        }
                    </div>
                </PropertyColumn>

                <PropertyColumn Title="Hình thức" Property="c => c.FeedbackType" Width="130">
                    <span class="text-dark">@(string.IsNullOrWhiteSpace(row.FeedbackType) ? "Thường" : row.FeedbackType)</span>
                </PropertyColumn>

                <PropertyColumn Title="Nhà máy" Property="c => c.Factory" Width="110" />

                <PropertyColumn Title="Phòng ban" Property="c => c.Department" Width="130" />

                <Column Title="Nhóm vấn đề" Width="220" TData="string">
                    @if (row.ParsedIssueGroups != null && row.ParsedIssueGroups.Count > 0)
                    {
                        <div class="issue-plain-list">
                            @foreach (var issue in row.ParsedIssueGroups)
                            {
                                <div class="issue-plain-item">• @issue</div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(row.IssueGroups))
                    {
                        <div class="issue-plain-item">• @row.IssueGroups</div>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </Column>

                <PropertyColumn Title="Mô tả sự việc" Property="c => c.Content">
                    <div class="title-cell" @onclick="() => ViewDetail(row)">
                        <span class="feedback-title">@GetSnippet(row.Content)</span>
                    </div>
                </PropertyColumn>

                <PropertyColumn Title="Đính kèm" Property="c => c.Attachments.Count" Width="90" Align="ColumnAlign.Center">
                    @if (row.Attachments != null && row.Attachments.Count > 0)
                    {
                        <span class="pointer-tag" @onclick="() => ViewDetail(row)">
                            <Tag Color="@("cyan")">
                                <Icon Type="paper-clip" /> @row.Attachments.Count tệp
                            </Tag>
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </PropertyColumn>

                <PropertyColumn Title="Ngày gửi" Property="c => c.CreatedAt" Format="dd/MM/yyyy HH:mm" Width="140" />

                <ActionColumn Title="Thao tác" Width="80" Align="ColumnAlign.Center">
                    <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" Icon="eye" OnClick="() => ViewDetail(row)">
                        Xem
                    </Button>
                </ActionColumn>
            </ColumnDefinitions>
        </Table>
    </div>
</div>

<!-- DETAIL & PROCESSING MODAL -->
@if (isModalVisible && selectedFeedback != null)
{
    <Modal Title="@modalTitle" 
           Visible="@isModalVisible" 
           OnCancel="() => isModalVisible = false" 
           Footer="@null" 
           Width="900">
        <div class="feedback-detail-modal">
            <!-- 1. THÔNG TIN NGƯỜI GỬI -->
            <div class="detail-section-card">
                <h5 class="section-subtitle mb-3"><Icon Type="user" /> 1. Thông tin người gửi</h5>
                <!-- Dòng 1: Người gửi (1 phần - 25%) & Hình thức phản ánh (3 phần - 75%) -->
                <div class="sender-grid-row-1 mb-3">
                    <div class="detail-item">
                        <span class="d-label">Người gửi:</span>
                        <strong class="d-value text-primary fs-6">@selectedFeedback.FullName</strong>
                    </div>
                    <div class="detail-item">
                        <span class="d-label">Hình thức phản ánh:</span>
                        <span class="d-value fw-medium">@(string.IsNullOrEmpty(selectedFeedback.FeedbackType) ? "Bình thường" : selectedFeedback.FeedbackType)</span>
                    </div>
                </div>

                <!-- Dòng 2: Nhà máy, Phòng ban, Số điện thoại, Thời gian gửi (4 phần bằng nhau) -->
                <div class="sender-grid-row-2">
                    <div class="detail-item">
                        <span class="d-label">Nhà máy:</span>
                        <span class="d-value">@(string.IsNullOrEmpty(selectedFeedback.Factory) ? "---" : selectedFeedback.Factory)</span>
                    </div>
                    <div class="detail-item">
                        <span class="d-label">Phòng ban:</span>
                        <span class="d-value">@(string.IsNullOrEmpty(selectedFeedback.Department) ? "---" : selectedFeedback.Department)</span>
                    </div>
                    <div class="detail-item">
                        <span class="d-label">Số điện thoại:</span>
                        <span class="d-value">@(string.IsNullOrEmpty(selectedFeedback.PhoneNumber) ? "Không có" : selectedFeedback.PhoneNumber)</span>
                    </div>
                    <div class="detail-item">
                        <span class="d-label">Thời gian gửi:</span>
                        <span class="d-value">@selectedFeedback.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</span>
                    </div>
                </div>
            </div>

            <!-- 2. NHÓM VẤN ĐỀ VI PHẠM (MỖI Ý 1 DÒNG, TEXT THƯỜNG KHÔNG MÀU) -->
            <div class="detail-section-card mt-3">
                <h5 class="section-subtitle mb-2"><Icon Type="unordered-list" /> 2. Nhóm vấn đề vi phạm</h5>
                <div class="detail-issue-box">
                    @if (selectedFeedback.ParsedIssueGroups != null && selectedFeedback.ParsedIssueGroups.Count > 0)
                    {
                        @foreach (var issue in selectedFeedback.ParsedIssueGroups)
                        {
                            <div class="detail-issue-line">• @issue</div>
                        }
                    }
                    else if (!string.IsNullOrEmpty(selectedFeedback.IssueGroups))
                    {
                        <div class="detail-issue-line">• @selectedFeedback.IssueGroups</div>
                    }
                    else
                    {
                        <span class="text-muted">Không có nhóm vấn đề cụ thể</span>
                    }
                </div>
            </div>

            <!-- 3. MÔ TẢ SỰ VIỆC & THÔNG TIN LIÊN QUAN -->
            <div class="detail-section-card mt-3">
                <h5 class="section-subtitle mb-2"><Icon Type="file-text" /> 3. Mô tả sự việc & Người liên quan</h5>
                <div class="mb-2">
                    <label class="fw-bold text-secondary">Mô tả sự việc:</label>
                    <div class="detail-content-box">
                        @selectedFeedback.Content
                    </div>
                </div>
                <div class="detail-row mt-2">
                    @if (!string.IsNullOrWhiteSpace(selectedFeedback.RelatedParties))
                    {
                        <div class="detail-item">
                            <span class="d-label">Bộ phận/Người liên quan:</span>
                            <span class="d-value">@selectedFeedback.RelatedParties</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(selectedFeedback.IncidentTimeLocation))
                    {
                        <div class="detail-item">
                            <span class="d-label">Thời gian & Địa điểm:</span>
                            <span class="d-value">@selectedFeedback.IncidentTimeLocation</span>
                        </div>
                    }
                </div>
            </div>

            <!-- 4. THIỆT HẠI & BẰNG CHỨNG -->
            @if (!string.IsNullOrWhiteSpace(selectedFeedback.HasFinancialLoss) || !string.IsNullOrWhiteSpace(selectedFeedback.HasEvidence))
            {
                <div class="detail-section-card mt-3">
                    <h5 class="section-subtitle mb-2"><Icon Type="safety-certificate" /> 4. Thiệt hại tài chính & Bằng chứng</h5>
                    <div class="detail-row">
                        <div class="detail-item">
                            <span class="d-label">Liên quan thiệt hại tài chính:</span>
                            <span class="d-value">@(selectedFeedback.HasFinancialLoss ?? "Không")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(selectedFeedback.EstimatedLossAmount))
                        {
                            <div class="detail-item">
                                <span class="d-label">Giá trị thiệt hại ước tính:</span>
                                <span class="d-value text-danger fw-bold">@selectedFeedback.EstimatedLossAmount</span>
                            </div>
                        }
                        <div class="detail-item">
                            <span class="d-label">Có bằng chứng:</span>
                            <span class="d-value">@(selectedFeedback.HasEvidence ?? "Không")</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(selectedFeedback.EvidenceDescription))
                    {
                        <div class="mt-2">
                            <span class="d-label">Mô tả bằng chứng:</span>
                            <div class="p-2 bg-light rounded text-dark mt-1">@selectedFeedback.EvidenceDescription</div>
                        </div>
                    }
                </div>
            }

            <!-- 5. TỆP ĐÍNH KÈM -->
            @if (selectedFeedback.Attachments != null && selectedFeedback.Attachments.Count > 0)
            {
                <div class="detail-section-card mt-3">
                    <h5 class="section-subtitle">
                        <Icon Type="paper-clip" /> 5. Tệp & Hình ảnh đính kèm (@selectedFeedback.Attachments.Count)
                    </h5>
                    <div class="attachment-gallery">
                        @foreach (var att in selectedFeedback.Attachments)
                        {
                            var proxyUrl = $"api/UserFeedback/attachments/{att.Id}";
                            if (IsPdfFile(att))
                            {
                                <div class="gallery-card pdf-card">
                                    <div class="gallery-pdf-wrap" @onclick="@(() => OpenInNewTab(proxyUrl))" title="Nhấn để xem PDF trên tab mới">
                                        <div class="pdf-icon-badge">
                                            <Icon Type="file-pdf" Class="pdf-symbol" />
                                            <span class="pdf-badge-label">PDF</span>
                                        </div>
                                        <div class="gallery-overlay">
                                            <Icon Type="eye" /> Xem PDF
                                        </div>
                                    </div>
                                    <div class="gallery-meta">
                                        <span class="g-name" title="@att.OriginalFileName">@att.OriginalFileName</span>
                                        <div class="gallery-btn-group">
                                            <a href="@proxyUrl" target="_blank" class="g-action-btn view-btn">
                                                <Icon Type="eye" /> Xem PDF
                                            </a>
                                            <a href="@proxyUrl" target="_blank" download="@att.OriginalFileName" class="g-action-btn download-btn">
                                                <Icon Type="download" /> Tải về
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (IsImageFile(att.FileName) || IsImageFile(att.OriginalFileName) || att.FileType?.StartsWith("image/") == true)
                            {
                                <div class="gallery-card image-card">
                                    <div class="gallery-thumb-wrap" @onclick="() => OpenPreviewImage(proxyUrl, att.OriginalFileName)" title="Nhấn để xem lớn">
                                        <img src="@proxyUrl" alt="@att.OriginalFileName" class="gallery-thumb" loading="lazy" />
                                        <div class="gallery-overlay">
                                            <Icon Type="zoom-in" /> Xem lớn
                                        </div>
                                    </div>
                                    <div class="gallery-meta">
                                        <span class="g-name" title="@att.OriginalFileName">@att.OriginalFileName</span>
                                        <div class="gallery-btn-group">
                                            <a href="@proxyUrl" target="_blank" download="@att.OriginalFileName" class="g-action-btn download-btn w-100 justify-content-center">
                                                <Icon Type="download" /> Tải về
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="gallery-card doc-card">
                                    <div class="gallery-file-wrap" @onclick="@(() => OpenInNewTab(proxyUrl))">
                                        <Icon Type="file" Class="generic-doc-icon" />
                                    </div>
                                    <div class="gallery-meta">
                                        <span class="g-name" title="@att.OriginalFileName">@att.OriginalFileName</span>
                                        <div class="gallery-btn-group">
                                            <a href="@proxyUrl" target="_blank" download="@att.OriginalFileName" class="g-action-btn download-btn w-100 justify-content-center">
                                                <Icon Type="download" /> Tải về
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            <div class="text-end mt-3">
                <Button Type="@ButtonType.Default" OnClick="() => isModalVisible = false">
                    Đóng
                </Button>
            </div>
        </div>
    </Modal>
}

<!-- IMAGE PREVIEW MODAL -->
@if (isImagePreviewVisible && !string.IsNullOrEmpty(previewImageUrl))
{
    <Modal Visible="@isImagePreviewVisible" 
           Footer="@null" 
           OnCancel="() => isImagePreviewVisible = false" 
           Width="900" 
           Centered="true">
        <div class="lightbox-container">
            <h5 class="lightbox-title">@previewImageTitle</h5>
            <div class="lightbox-img-wrap">
                <img src="@previewImageUrl" alt="@previewImageTitle" class="lightbox-img" />
            </div>
            <div class="lightbox-actions text-center mt-3">
                <a href="@previewImageUrl" target="_blank" download="@previewImageTitle" class="btn btn-outline-primary btn-sm">
                    <Icon Type="download" /> Tải ảnh gốc
                </a>
            </div>
        </div>
    </Modal>
}

@code {
    private RenderFragment SearchIcon => @<Icon Type="search" />;

    private List<UserFeedbackDto> feedbacks = new();
    private List<string> factories = new();
    private List<string> departments = new();
    private UserFeedbackFilterDto filter = new() { PageIndex = 1, PageSize = 10 };
    private int totalCount = 0;
    private bool isLoading = false;

    // Dashboard Statistics (Theo giao diện Apps Script)
    private FeedbackDashboardStatsDto dashboardStats = new();

    // Detail Modal
    private bool isModalVisible = false;
    private UserFeedbackDto? selectedFeedback;
    private string modalTitle => selectedFeedback != null ? $"Chi Tiết Ý Kiến - {selectedFeedback.FullName}" : "Chi Tiết Ý Kiến";

    // Image Lightbox
    private bool isImagePreviewVisible = false;
    private string previewImageUrl = "";
    private string previewImageTitle = "";

    // Sync State
    private bool isSyncing = false;
    private DateTime? lastSyncTime;
    private string lastSyncMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadFactories();
        await LoadDepartments();
        await LoadSyncStatus();
        await LoadStats();
        await LoadData(1);
    }

    private async Task LoadStats()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<FeedbackDashboardStatsDto>("api/UserFeedback/dashboard-stats");
            if (res != null)
            {
                dashboardStats = res;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard stats: {ex.Message}");
        }
    }

    private async Task LoadSyncStatus()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<FeedbackSyncStatusDto>("api/UserFeedback/sync-status");
            if (res != null && res.LastSyncTime.HasValue)
            {
                lastSyncTime = res.LastSyncTime;
                lastSyncMessage = res.Status == "Success" ? $"Mới: {res.NewRows}, Đã có: {res.SkippedRows}" : res.Status;
            }
        }
        catch { }
    }

    private async Task SyncFromGoogleSheet()
    {
        if (isSyncing) return;
        try
        {
            isSyncing = true;
            await Message.Loading("Đang kết nối và đồng bộ dữ liệu từ Google Sheet...", 1);

            var res = await Http.PostAsync("api/UserFeedback/sync", null);
            if (res.IsSuccessStatusCode)
            {
                var resultDto = await res.Content.ReadFromJsonAsync<FeedbackSyncResultDto>();
                if (resultDto != null && resultDto.Success)
                {
                    lastSyncTime = resultDto.LastSyncTime ?? DateTime.Now;
                    lastSyncMessage = $"Mới: {resultDto.NewCount}, Đã có: {resultDto.SkippedCount}";
                    await Message.Success(resultDto.Message);
                    await LoadStats();
                    await LoadData(1);
                }
                else
                {
                    await Message.Warning(resultDto?.Message ?? "Đồng bộ không thành công.");
                }
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                await Message.Error($"Lỗi đồng bộ: {err}");
            }
        }
        catch (Exception ex)
        {
            await Message.Error($"Lỗi kết nối: {ex.Message}");
        }
        finally
        {
            isSyncing = false;
        }
    }

    private async Task LoadFactories()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<string>>("api/UserFeedback/factories");
            if (res != null) factories = res;
        }
        catch { }
    }

    private async Task LoadDepartments()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<string>>("api/UserFeedback/departments");
            if (res != null) departments = res;
        }
        catch { }
    }

    private async Task LoadData(int pageIndex)
    {
        try
        {
            isLoading = true;
            filter.PageIndex = pageIndex;

            var queryString = $"api/UserFeedback/list?pageIndex={filter.PageIndex}&pageSize={filter.PageSize}";
            if (!string.IsNullOrWhiteSpace(filter.SearchTerm))
                queryString += $"&searchTerm={Uri.EscapeDataString(filter.SearchTerm)}";
            if (!string.IsNullOrWhiteSpace(filter.Factory))
                queryString += $"&factory={Uri.EscapeDataString(filter.Factory)}";
            if (!string.IsNullOrWhiteSpace(filter.Department))
                queryString += $"&department={Uri.EscapeDataString(filter.Department)}";
            if (filter.FromDate.HasValue)
                queryString += $"&fromDate={filter.FromDate.Value:yyyy-MM-dd}";
            if (filter.ToDate.HasValue)
                queryString += $"&toDate={filter.ToDate.Value:yyyy-MM-dd}";

            var res = await Http.GetFromJsonAsync<FeedbackPagedResult<UserFeedbackDto>>(queryString);
            if (res != null)
            {
                feedbacks = res.Items;
                totalCount = res.TotalCount;
            }
            await LoadStats();
        }
        catch (Exception ex)
        {
            await Message.Error($"Lỗi tải danh sách: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnPageChange(PaginationEventArgs args)
    {
        await LoadData(args.Page);
    }

    private async Task ResetFilter()
    {
        filter = new UserFeedbackFilterDto { PageIndex = 1, PageSize = 10 };
        await LoadData(1);
    }

    private void ViewDetail(UserFeedbackDto item)
    {
        selectedFeedback = item;
        isModalVisible = true;
    }

    private void OpenPreviewImage(string url, string title)
    {
        previewImageUrl = url;
        previewImageTitle = title;
        isImagePreviewVisible = true;
    }

    private bool IsPdfFile(UserFeedbackAttachmentDto? att)
    {
        if (att == null) return false;
        if (!string.IsNullOrEmpty(att.FileType) && att.FileType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase)) return true;
        if (!string.IsNullOrEmpty(att.OriginalFileName) && att.OriginalFileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)) return true;
        if (!string.IsNullOrEmpty(att.FileName) && att.FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private bool IsImageFile(string? fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName)) return false;
        var ext = Path.GetExtension(fileName).ToLower();
        return ext is ".jpg" or ".jpeg" or ".png" or ".webp" or ".gif" or ".bmp" or ".svg";
    }

    private async Task OpenInNewTab(string url)
    {
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{(bytes / (1024.0 * 1024.0)):F1} MB";
    }

    private string GetSnippet(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";
        return content.Length > 80 ? content.Substring(0, 80) + "..." : content;
    }
}

